{
  "info": {
    "_postman_id": "a9b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d",
    "name": "Scalable E-Commerce System API",
    "description": "Postman collection for the Scalable E-Commerce System backend. Contains currently implemented endpoints for system liveness, dependency readiness, and Phase 5 user authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "description": "Infrastructure and application health-check endpoints",
      "item": [
        {
          "name": "Process Liveness Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response body contains status UP and application name\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "    pm.expect(jsonData.application).to.eql(\"ecommerce-backend\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Verifies that the backend Spring Boot process is running and responding to requests."
          },
          "response": []
        },
        {
          "name": "Dependency Readiness Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK (all dependencies UP) or 503 SERVICE UNAVAILABLE (degraded)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response payload contains application, mongodb, and redis statuses\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"application\", \"ecommerce-backend\");",
                  "    pm.expect(jsonData).to.have.property(\"mongodb\");",
                  "    pm.expect(jsonData).to.have.property(\"redis\");",
                  "    pm.expect([\"UP\", \"DOWN\"]).to.include(jsonData.mongodb);",
                  "    pm.expect([\"UP\", \"DOWN\"]).to.include(jsonData.redis);",
                  "",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(jsonData.mongodb).to.eql(\"UP\");",
                  "        pm.expect(jsonData.redis).to.eql(\"UP\");",
                  "    } else {",
                  "        pm.expect(jsonData.mongodb === \"DOWN\" || jsonData.redis === \"DOWN\").to.be.true;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health/dependencies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "dependencies"
              ]
            },
            "description": "Verifies connectivity to MongoDB and Redis dependencies. Returns 200 OK if both are UP, or 503 Service Unavailable if either is DOWN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "User registration, authentication, and token verification endpoints",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Registration response has envelope and safe user details\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.message).to.include(\"User registered successfully\");",
                  "    pm.expect(jsonData.data).to.have.property(\"id\");",
                  "    pm.expect(jsonData.data.email).to.eql(\"jane.doe@example.com\");",
                  "    pm.expect(jsonData.data.role).to.eql(\"CUSTOMER\");",
                  "    pm.expect(jsonData.data.password).to.be.undefined;",
                  "    pm.expect(jsonData.data.passwordHash).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new customer account. Returns HTTP 201 with public profile details, omitting sensitive password hashes."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Authentication response contains JWT access token\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property(\"accessToken\");",
                  "    pm.expect(jsonData.data.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.data.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(jsonData.data.expiresIn).to.be.a(\"number\").and.above(0);",
                  "    pm.expect(jsonData.data.user.email).to.eql(\"jane.doe@example.com\");",
                  "",
                  "    // Store token in collection and environment variables for subsequent requests",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                  "    if (pm.environment) {",
                  "        pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates user credentials and returns a signed JWT access token. The test script automatically saves the token to {{accessToken}}."
          },
          "response": []
        },
        {
          "name": "Get Current User Profile (Protected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Profile matches authenticated user\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.email).to.eql(\"jane.doe@example.com\");",
                  "    pm.expect(jsonData.data.role).to.eql(\"CUSTOMER\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Protected endpoint verifying Bearer JWT authentication and returning the caller's profile."
          },
          "response": []
        },
        {
          "name": "Get Current User (Unauthenticated - 401 Expected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Error response adheres to standard error format\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(401);",
                  "    pm.expect(jsonData.error).to.eql(\"Unauthorized\");",
                  "    pm.expect(jsonData.path).to.eql(\"/api/v1/auth/me\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Negative test proving that accessing a protected endpoint without an Authorization header is rejected with HTTP 401."
          },
          "response": []
        }
      ]
    }
  ]
}
