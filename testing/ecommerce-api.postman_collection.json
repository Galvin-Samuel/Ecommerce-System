{
  "info": {
    "_postman_id": "a9b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d",
    "name": "Scalable E-Commerce System API",
    "description": "Postman collection for the Scalable E-Commerce System backend. Contains currently implemented endpoints for system liveness and dependency readiness verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "description": "Infrastructure and application health-check endpoints",
      "item": [
        {
          "name": "Process Liveness Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response body contains status UP and application name\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "    pm.expect(jsonData.application).to.eql(\"ecommerce-backend\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Verifies that the backend Spring Boot process is running and responding to requests."
          },
          "response": []
        },
        {
          "name": "Dependency Readiness Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK (all dependencies UP) or 503 SERVICE UNAVAILABLE (degraded)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response payload contains application, mongodb, and redis statuses\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"application\", \"ecommerce-backend\");",
                  "    pm.expect(jsonData).to.have.property(\"mongodb\");",
                  "    pm.expect(jsonData).to.have.property(\"redis\");",
                  "    pm.expect([\"UP\", \"DOWN\"]).to.include(jsonData.mongodb);",
                  "    pm.expect([\"UP\", \"DOWN\"]).to.include(jsonData.redis);",
                  "",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(jsonData.mongodb).to.eql(\"UP\");",
                  "        pm.expect(jsonData.redis).to.eql(\"UP\");",
                  "    } else {",
                  "        pm.expect(jsonData.mongodb === \"DOWN\" || jsonData.redis === \"DOWN\").to.be.true;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health/dependencies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health",
                "dependencies"
              ]
            },
            "description": "Verifies connectivity to MongoDB and Redis dependencies. Returns 200 OK if both are UP, or 503 Service Unavailable if either is DOWN."
          },
          "response": []
        }
      ]
    }
  ]
}

